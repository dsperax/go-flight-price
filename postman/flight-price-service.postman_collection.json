    {
      "name": "Subscribe (SSE)",
      "item": [
        {
          "name": "Subscribe – success (GRU-JFK)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/subscribe/GRU-JFK",
              "host": ["{{base_url}}"],
              "path": ["subscribe", "GRU-JFK"]
            },
            "description": "Opens a Server-Sent Events stream for the GRU→JFK route.\n\nThe server emits one event immediately on connect, then repeats every 30 seconds.\nEach event is a JSON payload containing the full flight search response.\n\n**Note:** Postman's Send button will keep the connection open. Use **Cancel** to close it. Check the response header `Content-Type: text/event-stream` and the body for `data: {...}` lines.\n\nRun **Login – success** first to populate `{{token}}`."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                  "pm.test('Content-Type is text/event-stream', () => {",
                  "    pm.expect(pm.response.headers.get('Content-Type')).to.include('text/event-stream');",
                  "});",
                  "pm.test('Cache-Control is no-cache', () => {",
                  "    pm.expect(pm.response.headers.get('Cache-Control')).to.eql('no-cache');",
                  "});"
                ]
              }
            }
          ]
        },
