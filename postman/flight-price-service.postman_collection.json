      "name": "History",
      "item": [
        {
          "name": "History – success (GRU → JFK)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/flights/history?origin=GRU&destination=JFK",
              "host": ["{{base_url}}"],
              "path": ["flights", "history"],
              "query": [
                { "key": "origin",      "value": "GRU" },
                { "key": "destination", "value": "JFK" }
              ]
            },
            "description": "Returns 24 months of historical average flight prices for the given route.\nRun **Login – success** first to populate `{{token}}`."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                  "pm.test('Content-Type is JSON', () => pm.response.to.have.header('Content-Type', 'application/json'));",
                  "",
                  "pm.test('Response shape is correct', () => {",
                  "    const body = pm.response.json();",
                  "    pm.expect(body.origin).to.eql('GRU');",
                  "    pm.expect(body.destination).to.eql('JFK');",
                  "    pm.expect(body.history).to.be.an('array');",
                  "});",
                  "",
                  "pm.test('Returns 24 monthly entries (last 2 years)', () => {",
                  "    pm.expect(pm.response.json().history).to.have.lengthOf(24);",
                  "});",
                  "",
                  "pm.test('Each entry has valid shape', () => {",
                  "    pm.response.json().history.forEach((m, i) => {",
                  "        pm.expect(m.year, `entry ${i} year`).to.be.a('number').and.above(0);",
                  "        pm.expect(m.month, `entry ${i} month`).to.be.within(1, 12);",
                  "        pm.expect(m.avg_price, `entry ${i} avg_price`).to.be.above(0);",
                  "        pm.expect(m.currency, `entry ${i} currency`).to.eql('BRL');",
                  "    });",
                  "});"
                ]
              }
            }
          ]
        },
