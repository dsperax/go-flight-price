              "raw": "{{base_url}}/auth/login",
              "host": ["{{base_url}}"],
              "path": ["auth", "login"]
            },
            "description": "Authenticates with valid credentials and returns a JWT Bearer token.\nThe test script saves the token into the `token` collection variable."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                  "",
                  "pm.test('Response has access_token', () => {",
                  "    const body = pm.response.json();",
                  "    pm.expect(body.access_token).to.be.a('string').and.not.empty;",
                  "    pm.expect(body.token_type).to.eql('Bearer');",
                  "    pm.expect(body.expires_in).to.be.a('number');",
                  "",
                  "    // Save token for subsequent requests",
                  "    pm.collectionVariables.set('token', body.access_token);",
                  "});"
                ]
              }
            }
          ]
        },
