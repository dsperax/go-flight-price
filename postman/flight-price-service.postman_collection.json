                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                  "pm.test('Content-Type is text/event-stream', () => {",
                  "    pm.expect(pm.response.headers.get('Content-Type')).to.include('text/event-stream');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Subscribe – invalid route format (400)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/subscribe/INVALIDROUTE",
              "host": ["{{base_url}}"],
              "path": ["subscribe", "INVALIDROUTE"]
            },
            "description": "Expects 400 when the route path parameter is not in ORIGIN-DESTINATION format."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 400', () => pm.response.to.have.status(400));",
                  "pm.test('Error is invalid_request', () => {",
                  "    pm.expect(pm.response.json().error).to.eql('invalid_request');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Subscribe – no token (401)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/subscribe/GRU-JFK",
              "host": ["{{base_url}}"],
              "path": ["subscribe", "GRU-JFK"]
            },
            "description": "Expects 401 when the Authorization header is missing."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 401', () => pm.response.to.have.status(401));",
                  "pm.test('Error code is unauthorized', () => {",
                  "    pm.expect(pm.response.json().error).to.eql('unauthorized');",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    }
