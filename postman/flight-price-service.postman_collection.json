    {
      "name": "Flights",
      "item": [
        {
          "name": "Search – success (GRU → JFK)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/flights/search?origin=GRU&destination=JFK&date=2026-06-10",
              "host": ["{{base_url}}"],
              "path": ["flights", "search"],
              "query": [
                { "key": "origin",      "value": "GRU" },
                { "key": "destination", "value": "JFK" },
                { "key": "date",        "value": "2026-06-10" }
              ]
            },
            "description": "Returns aggregated flight results from all providers, sorted by price ascending.\nRun **Login – success** first to populate `{{token}}`."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                  "pm.test('Content-Type is JSON', () => pm.response.to.have.header('Content-Type', 'application/json'));",
                  "",
                  "pm.test('Response shape is correct', () => {",
                  "    const body = pm.response.json();",
                  "    pm.expect(body.origin).to.eql('GRU');",
                  "    pm.expect(body.destination).to.eql('JFK');",
                  "    pm.expect(body.date).to.eql('2026-06-10');",
                  "    pm.expect(body.flights).to.be.an('array').and.not.empty;",
                  "    pm.expect(body.cheapest_flight).to.be.an('object');",
                  "    pm.expect(body.fastest_flight).to.be.an('object');",
                  "    pm.expect(body.cached).to.be.a('boolean');",
                  "});",
                  "",
                  "pm.test('Flights are sorted by price ascending', () => {",
                  "    const flights = pm.response.json().flights;",
                  "    for (let i = 1; i < flights.length; i++) {",
                  "        pm.expect(flights[i].price).to.be.at.least(flights[i - 1].price);",
                  "    }",
                  "});",
                  "",
                  "pm.test('cheapest_flight has the lowest price', () => {",
                  "    const body = pm.response.json();",
                  "    const minPrice = Math.min(...body.flights.map(f => f.price));",
                  "    pm.expect(body.cheapest_flight.price).to.eql(minPrice);",
                  "});",
                  "",
                  "pm.test('fastest_flight has the lowest duration', () => {",
                  "    const body = pm.response.json();",
                  "    const minDuration = Math.min(...body.flights.map(f => f.duration_minutes));",
                  "    pm.expect(body.fastest_flight.duration_minutes).to.eql(minDuration);",
                  "});"
                ]
              }
            }
          ]
        },
